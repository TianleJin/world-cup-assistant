# Supabase (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# football-data.org (from your account page after sign-up)
FOOTBALL_DATA_API_TOKEN=your-token

# NewsAPI (from newsapi.org after sign-up)
NEWS_API_KEY=your-key

# The Odds API (from the-odds-api.com after sign-up)
ODDS_API_KEY=your-key
# Check your Odds API dashboard → Available Sports for the exact World Cup sport key
ODDS_API_SPORT_KEY=soccer_fifa_world_cup

# Secret for the bet-settlement cron job (make up any random string)
CRON_SECRET=your-random-string

# YouTube Data API v3 (Google Cloud Console → Enable YouTube Data API v3 → Create API key)
YOUTUBE_API_KEY=your-key
